<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quick Sliding Puzzle</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            background-color: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 30px;
            width: 90%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        h1 {
            color: #00f2fe;
            margin-bottom: 5px;
            font-size: 2rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        p.desc {
            font-size: 0.9rem;
            color: #ccc;
            margin-bottom: 20px;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            background-color: rgba(0, 0, 0, 0.25);
            padding: 12px;
            border-radius: 12px;
        }

        .stat-box h2 {
            font-size: 0.9rem;
            color: #4facfe;
            text-transform: uppercase;
        }

        .stat-box p {
            font-size: 1.4rem;
            font-weight: bold;
        }

        .board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 25px;
            background-color: rgba(0, 0, 0, 0.3);
            padding: 10px;
            border-radius: 14px;
        }

        .tile {
            background: linear-gradient(145deg, #00c6ff, #0072ff);
            color: white;
            font-size: 2rem;
            font-weight: bold;
            aspect-ratio: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 10px;
            cursor: pointer;
            user-select: none;
            transition: transform 0.1s ease, background 0.2s;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }

        .tile:hover:not(.empty) {
            transform: scale(1.03);
            filter: brightness(1.1);
        }

        .tile.empty {
            background: transparent;
            box-shadow: none;
            cursor: default;
        }

        #btn-start {
            width: 100%;
            background: linear-gradient(45deg, #11998e, #38ef7d);
            border: none;
            color: #111;
            font-size: 1.1rem;
            font-weight: bold;
            padding: 14px;
            border-radius: 10px;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
            box-shadow: 0 4px 15px rgba(56, 239, 125, 0.3);
        }

        #btn-start:hover {
            opacity: 0.9;
        }

        #btn-start:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Quick Puzzle</h1>
        <p class="desc">Urutkan angka 1-8 secepat mungkin!</p>

        <div class="stats">
            <div class="stat-box">
                <h2>Langkah</h2>
                <p id="moves">0</p>
            </div>
            <div class="stat-box">
                <h2>Waktu</h2>
                <p id="timer">0s</p>
            </div>
        </div>

        <div class="board" id="board">
            <!-- Papan dibuat oleh JavaScript -->
        </div>

        <button id="btn-start" onclick="resetGame()">Mulai Ulang / Acak</button>
    </div>

    <script>
        let tiles = [1, 2, 3, 4, 5, 6, 7, 8, 0]; // 0 mewakili kotak kosong
        let moves = 0;
        let timer = 0;
        let timerInterval = null;
        let gameStarted = false;

        const boardEl = document.getElementById('board');
        const movesEl = document.getElementById('moves');
        const timerEl = document.getElementById('timer');

        function renderBoard() {
            boardEl.innerHTML = '';
            tiles.forEach((value, index) => {
                const tile = document.createElement('div');
                tile.className = 'tile' + (value === 0 ? ' empty' : '');
                tile.textContent = value !== 0 ? value : '';
                tile.onclick = () => moveTile(index);
                boardEl.appendChild(tile);
            });
        }

        function moveTile(index) {
            if (!gameStarted) startTimer();

            const emptyIndex = tiles.indexOf(0);
            const validMoves = getValidMoves(emptyIndex);

            // Jika kotak yang diklik berada di sebelah kotak kosong
            if (validMoves.includes(index)) {
                // Tukar posisi
                [tiles[index], tiles[emptyIndex]] = [tiles[emptyIndex], tiles[index]];
                moves++;
                movesEl.textContent = moves;
                renderBoard();
                checkWin();
            }
        }

        function getValidMoves(emptyIndex) {
            const valid = [];
            const row = Math.floor(emptyIndex / 3);
            const col = emptyIndex % 3;

            if (row > 0) valid.push(emptyIndex - 3); // Atas
            if (row < 2) valid.push(emptyIndex + 3); // Bawah
            if (col > 0) valid.push(emptyIndex - 1); // Kiri
            if (col < 2) valid.push(emptyIndex + 1); // Kanan

            return valid;
        }

        function shuffleBoard() {
            // Melakukan pergerakan acak valid agar puzzle selalu bisa diselesaikan (solvable)
            for (let i = 0; i < 100; i++) {
                const emptyIndex = tiles.indexOf(0);
                const validMoves = getValidMoves(emptyIndex);
                const randomMove = validMoves[Math.floor(Math.random() * validMoves.length)];
                [tiles[randomMove], tiles[emptyIndex]] = [tiles[emptyIndex], tiles[randomMove]];
            }
        }

        function startTimer() {
            gameStarted = true;
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timer++;
                timerEl.textContent = timer + 's';
            }, 1000);
        }

        function checkWin() {
            const winState = [1, 2, 3, 4, 5, 6, 7, 8, 0];
            const isWin = tiles.every((val, index) => val === winState[index]);

            if (isWin) {
                clearInterval(timerInterval);
                setTimeout(() => {
                    alert(`Selamat! Kamu berhasil menyelesaikannya!\n\nLangkah: ${moves}\nWaktu: ${timer} detik`);
                    gameStarted = false;
                }, 200);
            }
        }

        function resetGame() {
            clearInterval(timerInterval);
            gameStarted = false;
            moves = 0;
            timer = 0;
            movesEl.textContent = moves;
            timerEl.textContent = '0s';
            shuffleBoard();
            renderBoard();
        }

        // Jalankan game pertama kali
        resetGame();
    </script>
</body>
</html>
