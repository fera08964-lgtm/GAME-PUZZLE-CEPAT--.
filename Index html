<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Neon Pulse Speed Matcher</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tone.js for Web Audio & Music Synthesis -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #080711;
            color: #ffffff;
            touch-action: manipulation;
            user-select: none;
            overflow: hidden;
        }

        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        .neon-border {
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.4), inset 0 0 15px rgba(0, 243, 255, 0.2);
            border: 2px solid #00f3ff;
        }

        .neon-text-cyan {
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.8), 0 0 20px rgba(0, 243, 255, 0.5);
        }

        .neon-text-pink {
            text-shadow: 0 0 10px rgba(255, 0, 127, 0.8), 0 0 20px rgba(255, 0, 127, 0.5);
        }

        .neon-box-pink {
            box-shadow: 0 0 20px rgba(255, 0, 127, 0.5);
            border: 2px solid #ff007f;
        }

        /* Gem styles and glow */
        .gem {
            transition: transform 0.15s ease-out, top 0.2s ease, left 0.2s ease, opacity 0.2s ease;
            cursor: pointer;
        }

        .gem:hover {
            transform: scale(1.08);
            z-index: 10;
        }

        .gem.selected {
            transform: scale(1.15);
            animation: pulse-gem 0.6s infinite alternate;
            z-index: 20;
            box-shadow: 0 0 25px #ffffff, 0 0 10px #00f3ff;
        }

        @keyframes pulse-gem {
            0% { filter: brightness(1); }
            100% { filter: brightness(1.5); }
        }

        .fever-glow {
            animation: fever-bg 0.5s infinite alternate;
        }

        @keyframes fever-bg {
            0% { box-shadow: 0 0 20px rgba(255, 230, 0, 0.5); }
            100% { box-shadow: 0 0 40px rgba(255, 0, 127, 0.9); }
        }

        /* Floating Score Text */
        .score-float {
            position: absolute;
            pointer-events: none;
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            animation: float-up 0.8s forwards ease-out;
            z-index: 50;
        }

        @keyframes float-up {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            50% { opacity: 1; transform: translateY(-20px) scale(1.3); }
            100% { opacity: 0; transform: translateY(-40px) scale(0.9); }
        }

        /* Glassmorphism */
        .glass-panel {
            background: rgba(18, 16, 38, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col justify-between items-center p-2 sm:p-4 select-none">

    <canvas id="bgCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <header class="w-full max-w-lg flex justify-between items-center z-10 glass-panel p-3 rounded-2xl neon-border">
        <div>
            <h1 class="text-xl sm:text-2xl font-black font-orbitron text-cyan-400 neon-text-cyan tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-bolt text-yellow-400"></i> NEON PULSE
            </h1>
            <p class="text-xs text-gray-400 font-semibold tracking-widest">SPEED MATCH PUZZLE</p>
        </div>
        <div class="flex items-center gap-2">
            <!-- Music Button -->
            <button id="btnMusic" onclick="toggleMusic()" class="w-10 h-10 rounded-xl bg-gray-800 hover:bg-gray-700 flex justify-center items-center text-gray-300 border border-cyan-500/30 transition">
                <i class="fa-solid fa-music text-pink-500" id="iconMusic"></i>
            </button>
            <!-- Sound FX Button -->
            <button id="btnSFX" onclick="toggleSFX()" class="w-10 h-10 rounded-xl bg-gray-800 hover:bg-gray-700 flex justify-center items-center text-gray-300 border border-cyan-500/30 transition">
                <i class="fa-solid fa-volume-high text-cyan-400" id="iconSFX"></i>
            </button>
        </div>
    </header>

    <main class="w-full max-w-lg flex flex-col items-center gap-3 z-10 my-auto">
        <!-- Stats Dashboard -->
        <div class="w-full grid grid-cols-3 gap-2">
            <!-- Score Card -->
            <div class="glass-panel p-2 sm:p-3 rounded-xl flex flex-col items-center border border-cyan-500/30">
                <span class="text-xs text-cyan-400 font-bold tracking-wider">SKOR</span>
                <span id="scoreText" class="text-xl sm:text-2xl font-black font-orbitron text-white">0</span>
            </div>

            <!-- Timer Card -->
            <div class="glass-panel p-2 sm:p-3 rounded-xl flex flex-col items-center border border-yellow-500/30" id="timerContainer">
                <span class="text-xs text-yellow-400 font-bold tracking-wider">WAKTU</span>
                <span id="timerText" class="text-xl sm:text-2xl font-black font-orbitron text-yellow-300">45s</span>
            </div>

            <!-- Best Score Card -->
            <div class="glass-panel p-2 sm:p-3 rounded-xl flex flex-col items-center border border-pink-500/30">
                <span class="text-xs text-pink-400 font-bold tracking-wider">TERTINGGI</span>
                <span id="highScoreText" class="text-xl sm:text-2xl font-black font-orbitron text-pink-300">0</span>
            </div>
        </div>

        <!-- Fever Bar & Combo Display -->
        <div class="w-full glass-panel p-2 rounded-xl flex flex-col gap-1 border border-purple-500/30 relative overflow-hidden" id="feverBox">
            <div class="flex justify-between items-center text-xs font-bold px-1">
                <span class="text-purple-400 tracking-wider flex items-center gap-1">
                    <i class="fa-solid fa-fire text-yellow-400"></i> FEVER METER
                </span>
                <span id="comboText" class="text-pink-400 font-orbitron text-sm">COMBO x1</span>
            </div>
            <!-- Progress Track -->
            <div class="w-full h-3 bg-gray-900/80 rounded-full overflow-hidden p-0.5 border border-purple-500/40">
                <div id="feverBar" class="h-full bg-gradient-to-r from-cyan-400 via-pink-500 to-yellow-400 rounded-full transition-all duration-300 w-0"></div>
            </div>
        </div>

        <div class="relative p-2 rounded-2xl glass-panel border border-cyan-500/40 shadow-2xl" id="boardWrapper">
            <!-- Particle Canvas Overlay for explosions -->
            <canvas id="fxCanvas" class="absolute inset-0 pointer-events-none z-30"></canvas>
            
            <!-- Puzzle Grid Container -->
            <div id="gridBoard" class="relative w-[320px] h-[320px] sm:w-[380px] sm:h-[380px] bg-black/40 rounded-xl overflow-hidden border border-white/5">
                <!-- Gems dynamically generated by JavaScript -->
            </div>
        </div>
    </main>

    <footer class="w-full max-w-lg text-center z-10 glass-panel py-2 px-4 rounded-xl border border-white/10 text-xs text-gray-400 flex justify-between items-center">
        <span><i class="fa-solid fa-hand-pointer text-cyan-400 mr-1"></i> Klik/Geser 2 Gem berdampingan</span>
        <span class="text-yellow-400 font-semibold"><i class="fa-solid fa-bolt mr-1"></i> Match 3+ cepat!</span>
    </footer>

    <div id="startModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex justify-center items-center p-4">
        <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-md w-full text-center neon-box-pink flex flex-col items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500 to-pink-500 flex justify-center items-center text-3xl shadow-lg animate-bounce">
                <i class="fa-solid fa-cubes text-white"></i>
            </div>
            <h2 class="text-3xl font-black font-orbitron text-white neon-text-pink">NEON PULSE</h2>
            <p class="text-sm text-gray-300">
                Cocokkan 3 atau lebih gem neon secepat mungkin sebelum waktu habis! Dapatkan **Combo Multiplier** & aktifkan **Fever Mode** untuk skor super tinggi.
            </p>
            <div class="bg-gray-900/80 p-3 rounded-xl w-full text-left text-xs text-gray-400 flex flex-col gap-1.5 border border-white/10">
                <div class="flex items-center gap-2"><i class="fa-solid fa-bolt text-yellow-400"></i> <span>Match 4 = Gem Peledak Baris/Kolom</span></div>
                <div class="flex items-center gap-2"><i class="fa-solid fa-star text-pink-400"></i> <span>Match 5 = Bomb Warna Neon Super</span></div>
                <div class="flex items-center gap-2"><i class="fa-solid fa-clock text-cyan-400"></i> <span>Match memberikan +1 hingga +3 detik ekstra</span></div>
            </div>
            <button onclick="startGame()" class="w-full py-4 bg-gradient-to-r from-cyan-500 via-pink-500 to-yellow-500 font-orbitron font-bold text-lg text-black rounded-xl hover:opacity-90 transition active:scale-95 shadow-xl mt-2">
                MAIN NOW <i class="fa-solid fa-play ml-2"></i>
            </button>
        </div>
    </div>

    <div id="gameOverModal" class="fixed inset-0 bg-black/90 backdrop-blur-md z-50 flex justify-center items-center p-4 hidden">
        <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-md w-full text-center neon-border flex flex-col items-center gap-4">
            <h2 class="text-3xl font-black font-orbitron text-yellow-400 neon-text-cyan">WAKTU HABIS!</h2>
            <div class="w-full my-2 flex flex-col gap-2">
                <div class="flex justify-between items-center px-4 py-2 bg-gray-900/60 rounded-xl border border-white/10">
                    <span class="text-gray-400">Skor Akhir:</span>
                    <span id="finalScore" class="text-2xl font-bold font-orbitron text-cyan-400">0</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 bg-gray-900/60 rounded-xl border border-white/10">
                    <span class="text-gray-400">Combo Maks:</span>
                    <span id="maxComboText" class="text-xl font-bold font-orbitron text-pink-400">x1</span>
                </div>
                <div class="flex justify-between items-center px-4 py-2 bg-gray-900/60 rounded-xl border border-white/10">
                    <span class="text-gray-400">Skor Terbaik:</span>
                    <span id="finalHighScore" class="text-xl font-bold font-orbitron text-yellow-400">0</span>
                </div>
            </div>
            <button onclick="startGame()" class="w-full py-3.5 bg-gradient-to-r from-cyan-400 to-pink-500 font-orbitron font-bold text-lg text-black rounded-xl hover:opacity-90 transition active:scale-95 shadow-lg">
                MAIN LAGI <i class="fa-solid fa-rotate-right ml-2"></i>
            </button>
        </div>
    </div>

    <script>
        let audioInitialized = false;
        let isMusicOn = true;
        let isSFXOn = true;

        // Tone.js Instruments
        let synthBass, synthLead, drumKick, drumSnare, sfxSynth;
        let bgmLoop;

        function initAudio() {
            if (audioInitialized) return;
            try {
                Tone.start();

                // Synthwave Bass Synth
                synthBass = new Tone.MonoSynth({
                    oscillator: { type: "sawtooth" },
                    envelope: { attack: 0.01, decay: 0.2, sustain: 0.2, release: 0.2 },
                    filterEnvelope: { attack: 0.01, decay: 0.1, sustain: 0.5, baseFrequency: 120, octaves: 2.5 }
                }).toDestination();
                synthBass.volume.value = -12;

                // Bright Synth Lead
                synthLead = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: "triangle" },
                    envelope: { attack: 0.02, decay: 0.1, sustain: 0.3, release: 0.4 }
                }).toDestination();
                synthLead.volume.value = -16;

                // Percussion
                drumKick = new Tone.MembraneSynth().toDestination();
                drumKick.volume.value = -8;

                // Sound Effects Synth
                sfxSynth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: "sine" },
                    envelope: { attack: 0.005, decay: 0.1, sustain: 0, release: 0.1 }
                }).toDestination();
                sfxSynth.volume.value = -6;

                // Energetic Synthwave BGM Sequence (128 BPM)
                Tone.Transport.bpm.value = 132;

                const bassLine = [
                    { time: "0:0:0", note: "A1" }, { time: "0:0:2", note: "A1" },
                    { time: "0:1:0", note: "A2" }, { time: "0:1:2", note: "A1" },
                    { time: "0:2:0", note: "F1" }, { time: "0:2:2", note: "F1" },
                    { time: "0:3:0", note: "G1" }, { time: "0:3:2", note: "G2" }
                ];

                const leadMelody = [
                    { time: "0:0:0", note: ["E4", "A4"] }, { time: "0:0:3", note: ["C5"] },
                    { time: "0:1:2", note: ["E5"] }, { time: "0:2:0", note: ["D5"] },
                    { time: "0:2:3", note: ["C5"] }, { time: "0:3:2", note: ["B4"] }
                ];

                const bassPart = new Tone.Part((time, value) => {
                    if (isMusicOn) synthBass.triggerAttackRelease(value.note, "8n", time);
                }, bassLine).start(0);
                bassPart.loop = true;
                bassPart.loopEnd = "1m";

                const leadPart = new Tone.Part((time, value) => {
                    if (isMusicOn) synthLead.triggerAttackRelease(value.note, "16n", time);
                }, leadMelody).start(0);
                leadPart.loop = true;
                leadPart.loopEnd = "1m";

                const drumPart = new Tone.Loop((time) => {
                    if (isMusicOn) {
                        drumKick.triggerAttackRelease("C1", "8n", time);
                    }
                }, "4n").start(0);

                Tone.Transport.start();
                audioInitialized = true;
            } catch (e) {
                console.log("Audio Init Warning:", e);
            }
        }

        function toggleMusic() {
            isMusicOn = !isMusicOn;
            document.getElementById('iconMusic').className = isMusicOn ? "fa-solid fa-music text-pink-500" : "fa-solid fa-music-slash text-gray-500";
            if (!audioInitialized && isMusicOn) initAudio();
        }

        function toggleSFX() {
            isSFXOn = !isSFXOn;
            document.getElementById('iconSFX').className = isSFXOn ? "fa-solid fa-volume-high text-cyan-400" : "fa-solid fa-volume-xmark text-gray-500";
        }

        function playSound(type, comboLevel = 1) {
            if (!isSFXOn || !audioInitialized) return;
            try {
                if (type === 'swap') {
                    sfxSynth.triggerAttackRelease("C5", "16n");
                } else if (type === 'match') {
                    const pitches = ["E5", "G5", "A5", "C6", "E6", "G6"];
                    const note = pitches[Math.min(comboLevel - 1, pitches.length - 1)];
                    sfxSynth.triggerAttackRelease(note, "12n");
                } else if (type === 'bomb') {
                    drumKick.triggerAttackRelease("G0", "4n");
                } else if (type === 'fever') {
                    sfxSynth.triggerAttackRelease(["C5", "E5", "G5", "C6"], "8n");
                } else if (type === 'gameover') {
                    sfxSynth.triggerAttackRelease(["C4", "G3", "D3"], "4n");
                }
            } catch (e) {}
        }

        const bgCanvas = document.getElementById('bgCanvas');
        const bgCtx = bgCanvas.getContext('2d');
        let bgParticles = [];

        function resizeBgCanvas() {
            bgCanvas.width = window.innerWidth;
            bgCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeBgCanvas);
        resizeBgCanvas();

        class BgParticle {
            constructor() {
                this.x = Math.random() * bgCanvas.width;
                this.y = Math.random() * bgCanvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedY = -(Math.random() * 0.8 + 0.2);
                this.color = Math.random() > 0.5 ? 'rgba(0, 243, 255, ' : 'rgba(255, 0, 127, ';
                this.alpha = Math.random() * 0.5 + 0.2;
            }
            update() {
                this.y += this.speedY;
                if (this.y < 0) {
                    this.y = bgCanvas.height;
                    this.x = Math.random() * bgCanvas.width;
                }
            }
            draw() {
                bgCtx.fillStyle = this.color + this.alpha + ')';
                bgCtx.beginPath();
                bgCtx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                bgCtx.fill();
            }
        }

        for (let i = 0; i < 40; i++) bgParticles.push(new BgParticle());

        function animateBg() {
            bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
            bgParticles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateBg);
        }
        animateBg();

        const fxCanvas = document.getElementById('fxCanvas');
        const fxCtx = fxCanvas.getContext('2d');
        let explosionParticles = [];

        function resizeFxCanvas() {
            const board = document.getElementById('gridBoard');
            fxCanvas.width = board.clientWidth;
            fxCanvas.height = board.clientHeight;
        }
        window.addEventListener('resize', resizeFxCanvas);

        class BurstParticle {
            constructor(x, y, color) {
                this.x = x;
                this.y = y;
                this.color = color;
                this.radius = Math.random() * 4 + 2;
                this.vx = (Math.random() - 0.5) * 8;
                this.vy = (Math.random() - 0.5) * 8;
                this.alpha = 1;
                this.decay = Math.random() * 0.03 + 0.02;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.alpha -= this.decay;
            }
            draw() {
                fxCtx.save();
                fxCtx.globalAlpha = Math.max(0, this.alpha);
                fxCtx.fillStyle = this.color;
                fxCtx.shadowBlur = 10;
                fxCtx.shadowColor = this.color;
                fxCtx.beginPath();
                fxCtx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                fxCtx.fill();
                fxCtx.restore();
            }
        }

        function spawnExplosion(x, y, color) {
            for (let i = 0; i < 14; i++) {
                explosionParticles.push(new BurstParticle(x, y, color));
            }
        }

        function animateFx() {
            fxCtx.clearRect(0, 0, fxCanvas.width, fxCanvas.height);
            for (let i = explosionParticles.length - 1; i >= 0; i--) {
                const p = explosionParticles[i];
                p.update();
                p.draw();
                if (p.alpha <= 0) explosionParticles.splice(i, 1);
            }
            requestAnimationFrame(animateFx);
        }
        animateFx();

        const GRID_
